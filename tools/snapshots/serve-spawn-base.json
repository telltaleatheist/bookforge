{
  "wsl": {
    "arm": "wsl",
    "command": "wsl.exe",
    "viaWsl": true,
    "args": [
      "-d",
      "Ubuntu",
      "bash",
      "-c"
    ],
    "bash": {
      "exports": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONIOENCODING": "utf-8",
        "ORPHEUS_DISABLE_EAGER": "1",
        "VLLM_USE_V1": "0",
        "ORPHEUS_GPU_MEM_UTIL": "0.62",
        "ORPHEUS_STREAM_BATCH": "16",
        "ORPHEUS_STREAM_RAMP": "8",
        "ORPHEUS_STREAM_WARM_MAX": "16",
        "EBOOK2AUDIOBOOK_PATH": "/home/fake/ebook2audiobook"
      },
      "cd": "cd '/home/fake/ebook2audiobook'",
      "run": "'/home/fake/anaconda3/bin/conda' run --no-capture-output -n 'orpheus_tts' python -u '<REPO-WSL>/electron/scripts/orpheus_stream.py'"
    },
    "env": "(inherited process.env — nothing crosses into the guest)",
    "cwd": "(process.cwd)"
  },
  "native-win": {
    "arm": "native-win",
    "command": "C:\\FAKE\\e2a\\python_env\\python.exe",
    "viaWsl": false,
    "args": [
      "-u",
      "<REPO>\\electron\\scripts\\orpheus_stream.py"
    ],
    "env": {
      "EBOOK2AUDIOBOOK_PATH": "C:\\FAKE\\e2a",
      "ORPHEUS_GPU_MEM_UTIL": "0.62",
      "ORPHEUS_STREAM_BATCH": "16",
      "ORPHEUS_STREAM_RAMP": "8",
      "ORPHEUS_STREAM_WARM_MAX": "16",
      "PYTHONIOENCODING": "utf-8",
      "PYTHONUNBUFFERED": "1",
      "VLLM_USE_V1": "0"
    },
    "cwd": "C:\\FAKE\\e2a"
  },
  "native-mac": {
    "arm": "native-mac",
    "command": "C:\\FAKE\\e2a\\python_env\\python.exe",
    "viaWsl": false,
    "args": [
      "-u",
      "<REPO>\\electron\\scripts\\orpheus_stream.py"
    ],
    "env": {
      "EBOOK2AUDIOBOOK_PATH": "C:\\FAKE\\e2a",
      "ORPHEUS_GPU_MEM_UTIL": "0.62",
      "ORPHEUS_MLX_CACHE_LIMIT_GB": "8",
      "ORPHEUS_MLX_MEM_BUDGET_GB": "24",
      "ORPHEUS_STREAM_BATCH": "16",
      "ORPHEUS_STREAM_RAMP": "8",
      "ORPHEUS_STREAM_WARM_MAX": "16",
      "PYTHONIOENCODING": "utf-8",
      "PYTHONUNBUFFERED": "1",
      "VLLM_USE_V1": "0"
    },
    "cwd": "C:\\FAKE\\e2a"
  },
  "higgs:wsl": {
    "arm": "wsl",
    "engine": "higgs",
    "command": "wsl.exe",
    "viaWsl": true,
    "args": [
      "-d",
      "Ubuntu",
      "bash",
      "-c"
    ],
    "bash": {
      "exports": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONIOENCODING": "utf-8",
        "NARRATOR_ENGINE": "higgs-v3",
        "NARRATOR_HIGGS_VOICES": "<TMP>/bookforge-higgs-voices/listen-default-default.json",
        "HIGGS_MAX_NUM_SEQS": "16",
        "NARRATOR_HIGGS3_WSL_DISTRO": "Ubuntu",
        "NARRATOR_HIGGS3_SERVE_SCRIPT": "/home/fake/anaconda3/envs/higgs3/bin/serve_higgs_v3.sh",
        "HIGGS_ENV": "/home/fake/anaconda3/envs/higgs3",
        "HIGGS_HOST": "127.0.0.1",
        "HIGGS_PORT": "8095",
        "HIGGS_GPU_MEM_UTIL": "0.35",
        "HIGGS_CODEC_GPU_MEM_UTIL": "0.1",
        "HIGGS_MAX_MODEL_LEN": "8192",
        "HIGGS_DEPLOY_CONFIG": "/home/fake/anaconda3/envs/higgs3/bin/higgs_default_frames7500.yaml",
        "PYTHONPATH": "<REPO>/python"
      },
      "cd": "cd ~",
      "run": "'/home/fake/anaconda3/bin/conda' run --no-capture-output -n 'higgs3' python -u -m narrator.serve"
    },
    "env": "(inherited process.env — nothing crosses into the guest)",
    "cwd": "(process.cwd)"
  },
  "higgs:native-win": {
    "arm": "native-win",
    "engine": "higgs",
    "refused": "Higgs runs on vLLM-Omni, which has no Windows build. Enable \"WSL2 for Higgs\" in Settings → Higgs and install the Higgs environment there."
  },
  "higgs:native-mac": {
    "arm": "native-mac",
    "engine": "higgs",
    "command": "/fake/miniconda/bin/conda",
    "viaWsl": false,
    "args": [
      "run",
      "--no-capture-output",
      "-p",
      "/opt/homebrew/Caskroom/miniconda/base/envs/narrator-mlx",
      "python",
      "-u",
      "-m",
      "narrator.serve"
    ],
    "mlxModelDirExists": true,
    "env": {
      "HIGGS_MAX_NUM_SEQS": "16",
      "NARRATOR_ENGINE": "higgs-v3",
      "NARRATOR_HIGGS_VOICES": "<TMP>/bookforge-higgs-voices/listen-default-default.json",
      "NARRATOR_HIGGS3_MLX_BATCH": "16",
      "NARRATOR_HIGGS3_MLX_MEM_BUDGET_GB": "24",
      "NARRATOR_HIGGS3_MLX_MODEL": "<REPO>/.fake-userdata/runtime/higgs-models/base",
      "PYTHONIOENCODING": "utf-8",
      "PYTHONPATH": "<REPO>/python",
      "PYTHONUNBUFFERED": "1"
    },
    "cwd": "<REPO>/.fake-userdata"
  }
}
