/* Renderer (Angular) program. The main process has its own — tsconfig.electron.json. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    // @owen/foundry-core BY SOURCE, for bun only (FOUNDRY-CORE-PLAN step 3).
    // bun reads the nearest tsconfig.json's paths, so app-side code it runs —
    // app/test/hosted-runner.test.ts importing electron/mount.ts — resolves the
    // package to ../packages/foundry-core/src, the SAME module instances the
    // test itself imports and spies on (one queue, one host record), and runs
    // the library as it is on disk with no build. The Angular build does NOT
    // use this: tsconfig.app.json empties paths, so the renderer takes the
    // package's built ES modules out of node_modules, and the main process
    // (tsconfig.electron.json, no paths) its CommonJS build.
    "paths": {
      "@owen/foundry-core/node/*": ["../packages/foundry-core/src/node/*"],
      "@owen/foundry-core/host": ["../packages/foundry-core/src/node/host"],
      "@owen/foundry-core/engine": ["../packages/foundry-core/src/node/engine"],
      "@owen/foundry-core/shared/*": ["../packages/foundry-core/src/shared/*"],
      "@owen/foundry-core/browser/*": ["../packages/foundry-core/src/shared-browser/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    // NG8113 IS AN ERROR HERE, and it is an error because of what it cost.
    // `EngineModelsCardComponent` was written, imported and listed in the
    // settings page's `imports:` on 59a3a8e and never placed in its template,
    // so the whole model panel -- a model per act, fetch, remove -- drew
    // nothing. The compiler SAID so on every build, as
    // "EngineModelsCardComponent is not used within the template of
    // SettingsPageComponent", and said it at `warning`, which is the default
    // for this check and which nothing reads: the build exits 0 and the line
    // scrolls past under a bundle-size warning that is always there.
    //
    // A standalone component's `imports:` is a CLAIM about its template, so an
    // entry the template never uses is the template missing an element, not a
    // tidiness problem. Promoting it is better than a test that greps for
    // selectors because the compiler already knows the answer exactly, for
    // every component, including the ones nobody thought to check.
    "extendedDiagnostics": {
      "checks": {
        "unusedStandaloneImports": "error"
      }
    }
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" }
  ]
}
