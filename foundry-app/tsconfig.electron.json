{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    // rootDir is app/, not app/electron, because this program also compiles
    // app/shared (the wire shapes the renderer compiles too). The emit layout is
    // electron/x.ts -> dist/electron/x.js and shared/y.ts -> dist/shared/y.js,
    // which is what dist/electron/*.js requires at runtime.
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "electron/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
