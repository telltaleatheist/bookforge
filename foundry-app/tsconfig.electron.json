{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    // rootDir is app/ so the emit layout stays electron/x.ts -> dist/electron/x.js
    // (package.json "main"). Everything that is not the shell, the window, the
    // preload, Crucible's UI window and the IPC/mount/documents wiring is
    // @owen/foundry-core, required by package name from node_modules at runtime
    // and typed by the package's own .d.ts (FOUNDRY-CORE-PLAN step 3).
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "electron/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
