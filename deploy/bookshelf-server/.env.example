# deploy:nas — the NAS's own facts, which the public repo must not carry.
#
# Copy this file to `.env` beside it (untracked) and fill it in. Both values are
# REQUIRED: deploy-nas.sh refuses by name rather than guessing, because a
# default hostname would ship this tree to whatever machine answers to it.

# The ssh host of the NAS running the bookshelf mirror — a ~/.ssh/config alias
# or a hostname. Must work keyless from the machine you deploy from.
BOOKFORGE_NAS_HOST=nas

# The health URL the deploy waits on after the container restarts. The NAS
# serves on 8766 rather than 8765 because UGOS's own file service owns 8765.
BOOKFORGE_NAS_HEALTH=http://192.0.2.125:8766/api/health

# Optional: where the one-commit staging checkout is cut. Defaults to a
# directory beside your home; must be OUTSIDE this repo.
#BOOKFORGE_NAS_STAGE=
